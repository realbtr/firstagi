*.log
*.pid

# ── Python ──
__pycache__/
*.pyc
.pytest_cache/
.venv/

# ── ОС/редакторы ──
Thumbs.db
.DS_Store
~$*

# Снапшоты-архивы могут содержать чужие .env — в git не ходят (О-7)
docs/archive/*.tar
docs/archive/*.zip

# ── Сборка пакетов ──
*.egg-info/
build/
dist/

