# Скопируйте этот файл в .secrets/keys.env и впишите свои ключи.
# .secrets/keys.env НИКОГДА не попадает в git (.gitignore, правило О-7).
# Переменные, уже установленные в системе/CI, главнее этого файла.
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROK_API_KEY=xai-...
# DEEPSEEK_API_KEY=sk-...
# QWEN_API_KEY=sk-...
# GEMINI_API_KEY=...
#
# Модель провайдера можно переопределить (совместимо со стендом):
# DEEPSEEK_MODEL=deepseek-chat
